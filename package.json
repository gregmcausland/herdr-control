{
  "name": "herdr-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n bridge,client -c cyan,magenta \"npm:dev:bridge\" \"npm:dev:client\"",
    "dev:bridge": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run src scripts",
    "test:browser": "playwright test",
    "test:browser:readonly": "playwright test tests/browser/live-readonly.spec.ts",
    "test:browser:mock": "npm run build:client && HERDR_CONTROL_TEST_MOCK=1 playwright test tests/browser/conversation.spec.ts tests/browser/conversation-echo.spec.ts tests/browser/mobile-input.spec.ts tests/browser/multi-host.spec.ts tests/browser/theme.spec.ts tests/browser/preferences.spec.ts tests/browser/new-thread.spec.ts tests/browser/new-thread-launch.spec.ts tests/browser/radial-menu.spec.ts",
    "control": "node scripts/herdr-control.mjs",
    "release:bundle": "node scripts/build-release.mjs",
    "validate:host-migration": "npm run build:server && node scripts/validate-host-migration.mjs",
    "start": "node dist/server/server/index.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
